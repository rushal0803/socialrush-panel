# Supabase project settings: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public URL used in authentication email redirects.
# Use http://localhost:3000 only in a local-only .env.local file.
NEXT_PUBLIC_SITE_URL=https://www.getsocialrush.com

# Public WhatsApp support link
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/918860330771

# Contact form email delivery. RESEND_API_KEY is required for /api/contact to send email.
RESEND_API_KEY=your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
CONTACT_TO_EMAIL=support@getsocialrush.com
CONTACT_FROM_EMAIL=SocialRUSH Website <onboarding@resend.dev>

# Automated customer email (server-only; verify getsocialrush.com in Resend first)
EMAIL_FROM=SocialRUSH <noreply@getsocialrush.com>
REPLY_TO_EMAIL=rushalthakur240@gmail.com

# Razorpay wallet integration
RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
RAZORPAY_INTERNATIONAL_ENABLED=false
NEXT_PUBLIC_RAZORPAY_ENABLE_UPI=true
NEXT_PUBLIC_RAZORPAY_ENABLE_CARD=true
NEXT_PUBLIC_RAZORPAY_ENABLE_NETBANKING=true
NEXT_PUBLIC_RAZORPAY_ENABLE_INTERNATIONAL_CARD=false

# Cashfree wallet integration (server-only credentials; keep sandbox until launch)
CASHFREE_CLIENT_ID=your_cashfree_sandbox_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_sandbox_client_secret
CASHFREE_ENV=sandbox
CASHFREE_INTERNATIONAL_ENABLED=false
# Server-only HTTPS base URL used for Cashfree return and webhook URLs.
CASHFREE_APP_BASE_URL=https://staging.example.com

# Server-only key used by verified payment webhooks. Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional server-only YouTube Data API key for automatic public subscriber/view/like counts.
# Orders still succeed and remain manually editable when this is not configured.
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key

# Future SMM provider adapter (server-only; outbound calls remain disabled)
SMM_PROVIDER_API_URL=https://provider.example/api
SMM_PROVIDER_API_KEY=your_provider_api_key

# Server-only secret for protected cron endpoints. Mirror this value in Supabase Vault
# as socialrush_email_cron_secret for the hourly email dispatcher; do not expose it to clients.
CRON_SECRET=replace_with_a_long_random_value
MONITORING_INCIDENT_COOLDOWN_MINUTES=30
MONITORING_SUPPORT_WARNING_HOURS=24
MONITORING_REFILL_WARNING_HOURS=48

# Android distribution (server-only). Point to a stable HTTPS release artifact.
ANDROID_APK_DOWNLOAD_URL=https://github.com/your-org/your-repo/releases/download/v1.0.0/SocialRUSH.apk
# Populate only after generating the persistent release keystore; never invent this value.
ANDROID_APP_SIGNING_CERT_SHA256=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99
